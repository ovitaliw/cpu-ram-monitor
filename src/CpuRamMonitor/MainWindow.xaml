<Window x:Class="CpuRamMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:CpuRamMonitor.Controls"
        Title="CPU/RAM Monitor"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" WindowStartupLocation="Manual"
        FontFamily="Segoe UI" Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <DataTemplate x:Key="ProcessRowTemplate">
            <Grid Height="28" Background="Transparent" ToolTip="{Binding Tooltip}">
                <Grid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{Binding HideLabel}" Click="HideProcess_Click" />
                    </ContextMenu>
                </Grid.ContextMenu>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="28" />
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="3" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" />
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding ValueText}" VerticalAlignment="Center"
                           HorizontalAlignment="Right" FontSize="12" Margin="0,0,6,0" />
                <Button Grid.Column="2" Style="{StaticResource KillButton}" Click="Kill_Click"
                        HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- Compact: 100x100, two vertical bars -->
        <Border x:Name="CompactView" Width="100" Height="100" CornerRadius="18"
                Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
            <Grid Margin="0,12,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border x:Name="CpuTrack" Width="20" CornerRadius="6" Background="#22FFFFFF"
                        BorderBrush="#50FFFFFF" BorderThickness="1" HorizontalAlignment="Center">
                    <Border x:Name="CpuBar" CornerRadius="5" VerticalAlignment="Bottom" Height="0"
                            Background="{StaticResource CpuBrush}" />
                </Border>
                <Border x:Name="RamTrack" Grid.Column="1" Width="20" CornerRadius="6" Background="#22FFFFFF"
                        BorderBrush="#50FFFFFF" BorderThickness="1" HorizontalAlignment="Center">
                    <Border x:Name="RamBar" CornerRadius="5" VerticalAlignment="Bottom" Height="0"
                            Background="{StaticResource RamBrush}" />
                </Border>

                <TextBlock x:Name="CpuCompactText" Grid.Row="1" HorizontalAlignment="Center" Margin="0,4,0,0"
                           FontSize="11" FontWeight="SemiBold" Text="0%" />
                <TextBlock x:Name="RamCompactText" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" Margin="0,4,0,0"
                           FontSize="11" FontWeight="SemiBold" Text="0%" />
                <TextBlock Grid.Row="2" HorizontalAlignment="Center" FontSize="9" Foreground="{StaticResource MutedBrush}" Text="CPU" />
                <TextBlock Grid.Row="2" Grid.Column="1" HorizontalAlignment="Center" FontSize="9" Foreground="{StaticResource MutedBrush}" Text="RAM" />
            </Grid>
        </Border>

        <!-- Expanded: rings, heavy-user lists, opacity -->
        <Border x:Name="ExpandedView" Visibility="Collapsed" Width="580" CornerRadius="18" Padding="16,10,16,16"
                Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
            <StackPanel>
                <DockPanel Height="26">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource IconButton}" Content="⚙" ToolTip="Editar processos ocultos (exclusions.txt)"
                                Click="EditExclusions_Click" />
                        <Button Style="{StaticResource IconButton}" Content="—" ToolTip="Comprimir" Click="Compact_Click" />
                        <Button Style="{StaticResource IconButton}" Content="✕" ToolTip="Fechar" Click="Close_Click" />
                    </StackPanel>
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="11"
                               Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                </DockPanel>

                <Grid Margin="0,2,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="CPU" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <Grid Width="124" Height="124">
                            <c:RingGauge x:Name="CpuRing" Thickness="14" Stroke="{StaticResource CpuBrush}" />
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="CpuRingText" HorizontalAlignment="Center" FontSize="24" FontWeight="SemiBold" Text="0%" />
                                <TextBlock x:Name="CpuRingSub" HorizontalAlignment="Center" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock Text="RAM" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <Grid Width="124" Height="124">
                            <c:RingGauge x:Name="RamRing" Thickness="14" Stroke="{StaticResource RamBrush}" />
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="RamRingText" HorizontalAlignment="Center" FontSize="24" FontWeight="SemiBold" Text="0%" />
                                <TextBlock x:Name="RamRingSub" HorizontalAlignment="Center" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <Border CornerRadius="12" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource DividerBrush}"
                            BorderThickness="1" Padding="10,6,8,8" MinHeight="176">
                        <StackPanel>
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="28" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Processo" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock Grid.Column="1" Text="CPU" FontSize="10" Foreground="{StaticResource MutedBrush}"
                                           HorizontalAlignment="Right" Margin="0,0,6,0" />
                            </Grid>
                            <ItemsControl x:Name="CpuList" ItemTemplate="{StaticResource ProcessRowTemplate}"
                                          ContextMenuOpening="List_ContextMenuOpening" ContextMenuClosing="List_ContextMenuClosing" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" CornerRadius="12" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource DividerBrush}"
                            BorderThickness="1" Padding="10,6,8,8" MinHeight="176">
                        <StackPanel>
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="28" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Processo" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock Grid.Column="1" Text="RAM" FontSize="10" Foreground="{StaticResource MutedBrush}"
                                           HorizontalAlignment="Right" Margin="0,0,6,0" />
                            </Grid>
                            <ItemsControl x:Name="RamList" ItemTemplate="{StaticResource ProcessRowTemplate}"
                                          ContextMenuOpening="List_ContextMenuOpening" ContextMenuClosing="List_ContextMenuClosing" />
                        </StackPanel>
                    </Border>
                </Grid>

                <DockPanel Margin="4,14,4,0">
                    <TextBlock DockPanel.Dock="Left" Text="Opacidade" FontSize="11" Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Slider x:Name="OpacitySlider" Style="{StaticResource BarSlider}" Minimum="0.3" Maximum="1" />
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
